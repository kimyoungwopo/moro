        "value",
        "easing"
      ],
      "properties": {
        "frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3599
        },
        "value": {
          "type": "number",
          "minimum": -8192,
          "maximum": 8192
        },
        "easing": {
