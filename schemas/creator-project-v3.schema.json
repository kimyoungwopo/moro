{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moro local editable project v3",
  "$comment": "Strict runtime parser and validators are authoritative: <=8MiB UTF8, depth <=32, no duplicate JSON keys, descriptor-safe plain data; names <=200 UTF16; frames ordered and duration-relative; equal path array lengths, control sums and open endpoints; same-topology morph keys; <=100 layers, <=2048 base+mask vertices, <=16384 morph-key vertices, <=100 keys/channel, <=10000 total keys; parent depth <=8 edges. Conservative world enclosure multiplies local max scale by 1+abs(tan(maxAbsSkew)), local min scale divided by same factor; min >=0.01 max <=100; origin plus full control hull/stroke/mask radius <=65536. Schema cannot enforce cross-field, graph, aggregate, UTF16, parser or finite-world rules. Export additionally <=2MiB and <=100000 recursive JSON values, depth <=64. No assets/expressions/effects/code.",
  "description": "All fields required. Exact frozen ProjectV3 variants. Local transforms follow official lottie-web 5.13.0: T(position) R(rotation) R(-axis) H(-tan(skew)) R(axis) S(scaleX,scaleY) T(-pivot). Flat bottom-to-top ordering; groups transform only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "width",
    "height",
    "fps",
    "durationFrames",
    "layers"
  ],
  "properties": {
    "version": {
      "const": 3
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "width": {
      "type": "integer",
      "minimum": 16,
      "maximum": 4096
    },
    "height": {
      "type": "integer",
      "minimum": 16,
      "maximum": 4096
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "durationFrames": {
      "type": "integer",
      "minimum": 2,
      "maximum": 3600
    },
    "layers": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/rect"
          },
          {
            "$ref": "#/$defs/ellipse"
          },
          {
            "$ref": "#/$defs/path"
          },
          {
            "$ref": "#/$defs/group"
          }
        ]
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*[^\\s\\uFEFF\\u0000-\\u001f\\u007f-\\u009f][^\\u0000-\\u001f\\u007f-\\u009f]*$",
      "description": "Runtime additionally limits to 200 UTF-16 code units (JSON Schema maxLength counts Unicode code points)."
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "vec2": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -4096,
        "maximum": 4096
      },
      "minItems": 2,
      "maxItems": 2
    },
    "xKey": {
      "type": "object",
      "additionalProperties": false,
