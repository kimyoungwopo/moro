{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moro local editable project v2 (not a provider schema)",
  "$comment": "Local-only. Strict byte parser and runtime validator are authoritative: <=8 MiB UTF-8, <=32 nesting, no duplicate JSON keys; UTF-16 name length <=200; unique IDs, group-only parents, acyclic graph <=8 edges; duration-relative ordered frames; dynamic rect radius; equal path array lengths, final open out-tangent zero, control sums; total <=2048 vertices and <=10000 keys; cumulative scale 0.01..100 and conservative world hull+stroke <=65536. Schema alone cannot enforce these cross-field/aggregate/graph/parser constraints. No provider activation, expressions, assets, code or inference.",
  "description": "All fields required; exact per-variant keys. Local transform T(x,y) R S T(-pivot); paths retain authored origin; bottom-to-top flat paint order. Native validity is not artistic approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "width",
    "height",
    "fps",
    "durationFrames",
    "layers"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "width": {
      "type": "integer",
      "minimum": 16,
      "maximum": 4096
    },
    "height": {
      "type": "integer",
      "minimum": 16,
      "maximum": 4096
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "durationFrames": {
      "type": "integer",
      "minimum": 2,
      "maximum": 3600
    },
    "layers": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/rect"
          },
          {
            "$ref": "#/$defs/ellipse"
          },
          {
            "$ref": "#/$defs/path"
          },
          {
            "$ref": "#/$defs/group"
          }
        ]
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*[^\\s\\uFEFF\\u0000-\\u001f\\u007f-\\u009f][^\\u0000-\\u001f\\u007f-\\u009f]*$",
      "description": "Runtime additionally limits to 200 UTF-16 code units (JSON Schema maxLength counts Unicode code points)."
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "vec2": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -4096,
        "maximum": 4096
      },
      "minItems": 2,
      "maxItems": 2
    },
    "xKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "value",
        "easing"
      ],
      "properties": {
        "frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3599
        },
        "value": {
          "type": "number",
          "minimum": -8192,
          "maximum": 8192
        },
        "easing": {
          "enum": [
            "linear",
            "ease-in",
            "ease-out",
            "ease-in-out"
          ]
        }
      }
    },
    "yKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "value",
        "easing"
      ],
      "properties": {
        "frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3599
        },
        "value": {
          "type": "number",
          "minimum": -8192,
          "maximum": 8192
        },
        "easing": {
          "enum": [
            "linear",
            "ease-in",
            "ease-out",
            "ease-in-out"
          ]
        }
      }
    },
    "scaleKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "value",
        "easing"
      ],
      "properties": {
        "frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3599
        },
        "value": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "easing": {
          "enum": [
            "linear",
            "ease-in",
            "ease-out",
            "ease-in-out"
          ]
        }
      }
    },
    "rotationKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "value",
        "easing"
      ],
      "properties": {
        "frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3599
        },
        "value": {
          "type": "number",
          "minimum": -3600,
          "maximum": 3600
        },
        "easing": {
          "enum": [
            "linear",
            "ease-in",
            "ease-out",
            "ease-in-out"
          ]
        }
      }
    },
    "opacityKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "value",
        "easing"
      ],
      "properties": {
        "frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3599
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "easing": {
          "enum": [
            "linear",
            "ease-in",
            "ease-out",
            "ease-in-out"
          ]
        }
      }
    },
    "tracks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "scale",
        "rotation",
        "opacity"
      ],
      "properties": {
        "x": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xKey"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "y": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/yKey"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "scale": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scaleKey"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "rotation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rotationKey"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "opacity": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opacityKey"
          },
          "minItems": 0,
          "maxItems": 100
        }
      }
    },
    "groupTracks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "scale",
        "rotation",
        "opacity"
      ],
      "properties": {
        "x": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xKey"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "y": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/yKey"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "scale": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scaleKey"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "rotation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rotationKey"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "opacity": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opacityKey"
          },
          "minItems": 0,
          "maxItems": 0
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closed",
        "vertices",
        "inTangents",
        "outTangents"
      ],
      "properties": {
        "closed": {
          "type": "boolean"
        },
        "vertices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vec2"
          },
          "minItems": 2,
          "maxItems": 256
        },
        "inTangents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vec2"
          },
          "minItems": 2,
          "maxItems": 256
        },
        "outTangents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vec2"
          },
          "minItems": 2,
          "maxItems": 256
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "closed": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "vertices": {
                "minItems": 3
              },
              "inTangents": {
                "minItems": 3
              },
              "outTangents": {
                "minItems": 3
              }
            }
          }
        }
      ]
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "parentId",
        "x",
        "y",
        "pivot",
        "scale",
        "rotation",
        "opacity",
        "tracks",
        "fill",
        "stroke",
        "strokeWidth",
        "width",
        "height",
        "cornerRadius"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "type": {
          "const": "rect"
        },
        "parentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "null"
            }
          ]
        },
        "x": {
          "type": "number",
          "minimum": -8192,
          "maximum": 8192
        },
        "y": {
          "type": "number",
          "minimum": -8192,
          "maximum": 8192
        },
        "pivot": {
          "$ref": "#/$defs/vec2"
        },
        "scale": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "rotation": {
          "type": "number",
          "minimum": -3600,
          "maximum": 3600
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "tracks": {
          "$ref": "#/$defs/tracks"
        },
        "fill": {
          "$ref": "#/$defs/color"
        },
        "stroke": {
          "$ref": "#/$defs/color"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 4096
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "maximum": 4096
        },
        "cornerRadius": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 2048
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ellipse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "parentId",
        "x",
        "y",
        "pivot",
        "scale",
        "rotation",
        "opacity",
        "tracks",
        "fill",
        "stroke",
        "strokeWidth",
        "width",
        "height",
        "cornerRadius"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "type": {
          "const": "ellipse"
        },
        "parentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "null"
            }
          ]
        },
        "x": {
          "type": "number",
          "minimum": -8192,
          "maximum": 8192
        },
        "y": {
          "type": "number",
          "minimum": -8192,
          "maximum": 8192
        },
        "pivot": {
          "$ref": "#/$defs/vec2"
        },
        "scale": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "rotation": {
          "type": "number",
          "minimum": -3600,
          "maximum": 3600
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "tracks": {
          "$ref": "#/$defs/tracks"
        },
        "fill": {
          "$ref": "#/$defs/color"
        },
        "stroke": {
          "$ref": "#/$defs/color"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 4096
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "maximum": 4096
        },
        "cornerRadius": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "parentId",
        "x",
        "y",
        "pivot",
        "scale",
        "rotation",
        "opacity",
        "tracks",
        "fill",
        "stroke",
        "strokeWidth",
        "path"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "type": {
          "const": "path"
        },
        "parentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "null"
            }
          ]
        },
        "x": {
          "type": "number",
          "minimum": -8192,
          "maximum": 8192
        },
        "y": {
          "type": "number",
          "minimum": -8192,
          "maximum": 8192
        },
        "pivot": {
          "$ref": "#/$defs/vec2"
        },
        "scale": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "rotation": {
          "type": "number",
          "minimum": -3600,
          "maximum": 3600
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "tracks": {
          "$ref": "#/$defs/tracks"
        },
        "fill": {
          "anyOf": [
            {
              "$ref": "#/$defs/color"
            },
            {
              "type": "null"
            }
          ]
        },
        "stroke": {
          "$ref": "#/$defs/color"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "path": {
          "$ref": "#/$defs/geometry"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "path": {
                "properties": {
                  "closed": {
                    "const": false
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "fill": {
                "type": "null"
              },
              "path": {
                "properties": {
                  "inTangents": {
                    "prefixItems": [
                      {
                        "const": [
                          0,
                          0
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "parentId",
        "x",
        "y",
        "pivot",
        "scale",
        "rotation",
        "opacity",
        "tracks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "type": {
          "const": "group"
        },
        "parentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "null"
            }
          ]
        },
        "x": {
          "type": "number",
          "minimum": -8192,
          "maximum": 8192
        },
        "y": {
          "type": "number",
          "minimum": -8192,
          "maximum": 8192
        },
        "pivot": {
          "$ref": "#/$defs/vec2"
        },
        "scale": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "rotation": {
          "type": "number",
          "minimum": -3600,
          "maximum": 3600
        },
        "opacity": {
          "const": 100
        },
        "tracks": {
          "$ref": "#/$defs/groupTracks"
        }
      }
    }
  }
}
